# Valtaris Studio — production environment (studio.<yourdomain>)
# Copy to studio.env, fill in the blanks, and keep it OUT of git.
# Bridge secrets/keys MUST match the Portal's env exactly.

# ---- Core Django / Label Studio ----
DJANGO_DB=postgresql
SECRET_KEY=                               # generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
LABEL_STUDIO_HOST=https://studio.<yourdomain>
DEBUG=false
LOG_LEVEL=WARNING
DISABLE_SIGNUP_WITHOUT_LINK=true          # non-negotiable: no public self-signup
COLLECT_ANALYTICS=false                   # don't phone home from a rebranded fork

# ---- Postgres (Studio's OWN database — do NOT share with the Portal) ----
POSTGRE_NAME=valtaris_studio
POSTGRE_USER=studio
POSTGRE_PASSWORD=                         # set a strong password (also used by studio-db)
POSTGRE_HOST=studio-db
POSTGRE_PORT=5432

# ---- Redis (async job queue; required by Label Studio) ----
REDIS_LOCATION=redis://studio-redis:6379/0

# ---- SSRF (prod: keep ON) ----
# The annotation webhook targets VALTARIS_PORTAL_BASE_URL. A PUBLIC portal host
# (portal.<yourdomain>) is fine with protection on; an INTERNAL/private portal
# address must be allowlisted, or webhook delivery is silently dropped.
SSRF_PROTECTION_ENABLED=true

# ---- Media storage (see DEPLOY.md §Storage) ----
# Launch: local volume (studio_media). Migrate to S3-compatible (Cloudflare R2 /
# DO Spaces) via LS cloud storage before task volume makes local disk impractical.

# ===== Valtaris ↔ Portal bridge (must match the Portal's env EXACTLY) =====
STUDIO_SSO_SECRET=                        # shared HS256 secret (SSO token + set-active push)
LABEL_STUDIO_WEBHOOK_SECRET=              # shared per-annotation webhook secret
VALTARIS_SERVICE_ACCOUNT_KEY=             # vlt_… (scopes: standing:read, worksummary:write, review:write)
VALTARIS_PORTAL_BASE_URL=https://portal.<yourdomain>
VALTARIS_PORTAL_LOGIN_URL=https://portal.<yourdomain>/login
VALTARIS_PORTAL_ONLY_LOGIN=true           # Studio is SSO-only; native login/signup redirect to the Portal
VALTARIS_STANDING_FAILURE_MODE=closed     # deny task serving when standing can't be determined (compliance-safe)
VALTARIS_ENFORCE_STANDING_GATE=false      # turn on once projects carry a track/tier tag (set_project_requirement)
