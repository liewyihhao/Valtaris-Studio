# Valtaris bridge configuration for the Studio (Label Studio) instance.
# Copy the relevant lines into the instance .env that the server reads
# (dev: %LOCALAPPDATA%/label-studio/label-studio/.env) and restart Studio.
# Secrets below are the DEV defaults and MUST match the Portal's env exactly.

# Shared secrets (must equal the Portal's values)
STUDIO_SSO_SECRET=dev-studio-sso-shared-secret-change-me
LABEL_STUDIO_WEBHOOK_SECRET=dev-label-studio-webhook-secret
# Optional: rotate the set-active channel independently (defaults to STUDIO_SSO_SECRET)
# VALTARIS_REVOKE_SECRET=

# Portal location
VALTARIS_PORTAL_BASE_URL=http://localhost:3011

# Service-account key (create in Portal /admin/integrations, name "label_studio",
# scopes standing:read + worksummary:write; the raw vlt_… key is shown once).
# Required for standing gating + work-summary. Leave blank until created.
VALTARIS_SERVICE_ACCOUNT_KEY=

# Standing gate (task-serve enforcement). OFF by default. Turn on only AFTER the
# service key is set and projects are tagged (set_project_requirement).
VALTARIS_ENFORCE_STANDING_GATE=false
# closed = deny when standing can't be determined (compliance-safe, default);
# open = allow during a Portal outage (a sanctioned worker could be served).
VALTARIS_STANDING_FAILURE_MODE=closed

# Tuning (optional; defaults shown)
# VALTARIS_STANDING_CACHE_TTL=60
# VALTARIS_STANDING_STALE_MAX=900
# VALTARIS_STANDING_TIMEOUT=4
# VALTARIS_SUMMARY_TIMEOUT=30

# Production only: LS blocks webhook delivery to loopback/private hosts unless
# SSRF protection is off (dev default) — keep this false in dev so the localhost
# Portal receives annotation webhooks.
# SSRF_PROTECTION_ENABLED=false
